{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Raytracer (Executable)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/raytracer",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "CMake: build"
    },
    {
      "name": "Debug Raytracer Tests (Catch2)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bin/raytracer_tests",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "CMake: build"
    }
  ]
}
